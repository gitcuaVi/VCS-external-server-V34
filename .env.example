APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Bootstrap account for the database-backed Admin Portal.
# Set ADMIN_SEED_PASSWORD to at least 12 characters before running the seeder.
ADMIN_SEED_NAME="Super Administrator"
ADMIN_SEED_USERNAME=superadmin
ADMIN_SEED_PASSWORD=
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
ADMIN_DASHBOARD_DB_CONNECT_TIMEOUT=3
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=360

FRESHDESK_SPOOL_ENABLED=true
FRESHDESK_SPOOL_PATH=/var/www/html/storage/app/freshdesk-spool
FRESHDESK_INGEST_QUEUE=freshdesk-ingest
FRESHDESK_SPOOL_DISPATCH_BATCH=250
FRESHDESK_INGEST_MAX_QUEUE_DEPTH=100
FRESHDESK_SPOOL_ENQUEUED_VISIBILITY_SECONDS=3600
FRESHDESK_SPOOL_PROCESSING_LEASE_SECONDS=180
FRESHDESK_SPOOL_GC_AFTER_SECONDS=3600
FRESHDESK_SPOOL_MAX_PAYLOAD_BYTES=1048576
FRESHDESK_SPOOL_MAX_ATTEMPTS=50
FRESHDESK_SPOOL_MAX_AGE_SECONDS=86400
FRESHDESK_SPOOL_LONG_BACKOFF_SECONDS=1800
FRESHDESK_SPOOL_RETRY_JITTER_SECONDS=120
FRESHDESK_SPOOL_JITTER_AFTER_ATTEMPT=7
FRESHDESK_GROUP_REFRESH_COOLDOWN_SECONDS=1800
FRESHDESK_GROUP_MISSING_TTL_SECONDS=1800
FRESHDESK_GROUP_LOCK_SECONDS=45
FRESHDESK_GROUP_LOCK_WAIT_SECONDS=2
FRESHDESK_FSYNC_DIR_BINARY=/usr/local/bin/fsync-dir
FRESHDESK_REQUIRE_DIRECTORY_FSYNC=true

FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_API_RATE_LIMIT_ENABLED=true
FRESHDESK_API_RATE_LIMIT=50
FRESHDESK_API_RATE_WINDOW_SECONDS=60
FRESHDESK_API_RATE_LIMIT_REDIS_CONNECTION=default
FRESHDESK_WEBHOOK_USER=admin
FRESHDESK_WEBHOOK_PASSWORD=
FRESHDESK_REOPEN_THRESHOLD=1440

ENABLE_LEGACY_TICKET_FILTER=false
GO_LIVE_TIMESTAMP=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Rocket.Chat Alert System (Hạng mục 6)
ROCKETCHAT_WEBHOOK_URL=
ROCKETCHAT_URL=http://rocketchat:3000
ROCKETCHAT_USER_ID=
ROCKETCHAT_TOKEN=
ROCKETCHAT_CHANNEL=GENERAL
ROCKETCHAT_ALERT_TIMEZONE=Asia/Ho_Chi_Minh
ROCKETCHAT_ALERT_DEDUP_SECONDS=300
ROCKETCHAT_ALERT_GLOBAL_RATE_SECONDS=60
ROCKETCHAT_ALERT_CLAIM_SECONDS=30
ROCKETCHAT_ALERT_STATE_RETENTION_SECONDS=604800
ROCKETCHAT_ALERT_STATE_PATH=/var/www/html/storage/framework/alerts/rocketchat-state.json
ROCKETCHAT_REDIS_MONITOR_ENABLED=true
ROCKETCHAT_REDIS_REMINDER_SECONDS=1800

ROCKETCHAT_AUDIT_ENABLED=true
ROCKETCHAT_AUDIT_PATH=/var/www/html/storage/app/rocketchat-audit
ROCKETCHAT_AUDIT_SYNC_BATCH=100
ROCKETCHAT_AUDIT_PENDING_TIMEOUT_SECONDS=300
ROCKETCHAT_AUDIT_PROCESSING_TIMEOUT_SECONDS=300
ROCKETCHAT_AUDIT_RETENTION_DAYS=30

ROCKETCHAT_AUDIT_REQUIRE_DIRECTORY_FSYNC=true
